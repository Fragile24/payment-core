# Copy to .env for local runs (Docker Compose reads this file automatically).
# Never commit real secrets; this file is the documented shape of the local env.

# --- Application -------------------------------------------------------------
SERVER_PORT=8080
# Leave empty for local development; use "local" for verbose logs or "prod" to
# exercise the production profile.
SPRING_PROFILES_ACTIVE=

# --- Datastores --------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/payment_core
DB_USERNAME=payment
DB_PASSWORD=payment
DB_POOL_SIZE=10

REDIS_HOST=localhost
REDIS_PORT=6379

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=payment
RABBITMQ_PASSWORD=payment

# --- HTTP publishing / outbox ------------------------------------------------
RABBITMQ_MANAGEMENT_PORT=15672

OUTBOX_ENABLED=true
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_DELAY=10s
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_CONFIRM_TIMEOUT=5s
# /actuator/health reports DOWN when more than this number of outbox rows are
# exhausted (FAILED).
OUTBOX_FAILED_HEALTH_THRESHOLD=100

# --- Read model consumer -----------------------------------------------------
LEDGER_CONSUMER_ENABLED=true

# --- Reconciliation ----------------------------------------------------------
RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL_MS=300000
RECONCILIATION_INITIAL_DELAY_MS=30000
RECONCILIATION_BATCH_SIZE=500
RECONCILIATION_OUTBOX_STUCK_AFTER=10m
RECONCILIATION_LOCK_TTL=10m

# --- Security ----------------------------------------------------------------
# OPEN for local development only. The prod profile refuses to start with OPEN.
SECURITY_MODE=OPEN
OAUTH2_ISSUER_URI=
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=
